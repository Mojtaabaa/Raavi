{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "System": "",
    "Redis": "",
    "Hangfire": ""
  },
  "Raavi": {
    "Hosting": {
      "SystemHost": "admin.raavi.local",
      "Addressing": "Subdomain",
      "PathPrefix": "t",
      "DefaultTenantCode": "",
      "TenantBaseDomains": [
        "raavi.local"
      ],
      "KnownProxies": [],
      "KnownNetworks": [],
      "PublicScheme": "https"
    },
    "Tenants": {
      "DeletionGraceDays": 14
    },
    "Defaults": {
      "Culture": "fa-IR",
      "TimeZone": "Asia/Tehran",
      "Calendar": "persian"
    },
    "Database": {
      "CompatibilityLevel": 160,
      "CommandTimeoutSeconds": 30
    },
    "Maintenance": {
      "OutboxRetentionDays": 14,
      "SessionRetentionDays": 30,
      "ErrorLogRetentionDays": 90
    },
    "Health": {
      "PublicStatus": true
    },
    "Avatars": {
      "MaxBytes": 524288,
      "MaxPixels": 1024
    },
    "Observability": {
      "OtlpEndpoint": ""
    }
  }
}
