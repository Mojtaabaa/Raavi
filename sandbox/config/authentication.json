{
  "Raavi": {
    "Authentication": {
      "SystemMfaRequired": true,
      "Session": {
        "CookieName": "__Host-raavi",
        "IdleTimeoutMinutes": 60,
        "AbsoluteTimeoutHours": 12,
        "SameSite": "Lax"
      },
      "Local": {
        "Enabled": true,
        "PasswordMinLength": 12,
        "LockoutThreshold": 5,
        "LockoutMinutes": 15,
        "RequireMfaForSystemAdministrators": true
      },
      "Bootstrap": {
        "SystemAdministrator": {
          "Email": "",
          "InitialPassword": "",
          "DisplayName": "Administrator"
        }
      },
      "CollaborationTicket": {
        "Issuer": "raavi-api",
        "Audience": "raavi-collaboration",
        "LifetimeSeconds": 60,
        "SigningKeyPath": ""
      }
    }
  }
}
